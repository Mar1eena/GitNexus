#Область ПрограммныйИнтерфейс

// Возвращает уровень риска клиента.
Функция УровеньРиска(Клиент, НаДату = Неопределено) Экспорт
	Возврат ВнутреннийРасчет(Клиент);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВнутреннийРасчет(Клиент)
	Возврат 1;
КонецФункции

#КонецОбласти
